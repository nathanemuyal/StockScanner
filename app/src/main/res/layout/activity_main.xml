<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:background="@color/color_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="STOCK SCANNER"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnLoadExcel"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="📁 בחר קובץ Excel"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvFileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="קובץ: לא נבחר"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvTotalProducts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="מוצרים בקובץ: 0"
            android:textSize="16sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/color_divider"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/tvCurrentLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📍 אין מיקום פעיל"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvApprovedCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="מוצרים שאושרו: 0"
            android:textSize="16sp"
            android:gravity="center" />

        <Button
            android:id="@+id/btnScanLocation"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="24dp"
            android:text="📷 סרוק מיקום"
            android:textSize="20sp" />

        <Button
            android:id="@+id/btnScanProduct"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginTop="16dp"
            android:text="📦 סרוק מוצר"
            android:textSize="22sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnFinishLocation"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="✅ סיים מיקום"
            android:textSize="16sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvScannedProductsLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="מוצרים במיקום זה:"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerScannedProducts"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:clipToOutline="true"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnSaveExcel"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="24dp"
            android:text="💾 שמור Excel"
            android:textSize="18sp" />

    </LinearLayout>
</ScrollView>
