<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Aim frame + crosshair: the code nearest the center wins when several
         are in view (shelf labels carry four Data Matrix codes, with product
         barcodes right next to them). -->
    <View
        android:layout_width="280dp"
        android:layout_height="180dp"
        android:layout_gravity="center"
        android:background="@drawable/scan_aim_frame" />

    <View
        android:layout_width="24dp"
        android:layout_height="2dp"
        android:layout_gravity="center"
        android:background="@color/scanner_overlay_text" />

    <View
        android:layout_width="2dp"
        android:layout_height="24dp"
        android:layout_gravity="center"
        android:background="@color/scanner_overlay_text" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/scanner_overlay_background"
            android:textColor="@color/scanner_overlay_text"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="20dp"
            android:text="" />

        <TextView
            android:id="@+id/tvLocationBadge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/scanner_badge_background"
            android:textColor="@color/scanner_overlay_text"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="14dp"
            android:visibility="gone"
            android:text="" />

    </LinearLayout>

    <!-- Both buttons centered and stacked vertically (rather than side by
         side) so neither can ever overlap the other regardless of button
         width — e.g. "🔦 כבה פנס" growing under a larger system font size —
         and without relying on start/end gravity, which would otherwise flip
         with the device's layout direction while these Hebrew labels stay
         fixed either way. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_margin="24dp">

        <!-- Torch toggle for dim shelving aisles. Hidden until the camera
             confirms the device actually has a flash unit (see startCamera()). -->
        <Button
            android:id="@+id/btnTorch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="🔦 הדלק פנס"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnCancelScan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ביטול" />

    </LinearLayout>

</FrameLayout>
