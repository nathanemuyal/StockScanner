<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:background="@color/color_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📗 פעולות Excel"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/tvFileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="קובץ נבחר: לא נבחר"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvTotalProducts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="מוצרים בקובץ: 0"
            android:textSize="16sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/color_divider"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnLoadExcel"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="📁 בחר קובץ Excel מקורי"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnSaveExcel"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:text="💾 שמור Excel"
            android:textSize="18sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/color_divider"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/tvLocationsFile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="קובץ מיקומים וכמויות: לא נוצר"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnCreateLocationsFile"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="📍 צור/עדכן קובץ מיקומים וכמויות"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvBarcodesFile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="קובץ ברקודים מרובים: לא נוצר"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnCreateBarcodesFile"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="🔀 צור/עדכן קובץ ברקודים מרובים"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnExportFiles"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="📤 ייצוא/שיתוף קבצים"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnCloseExcelActions"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="חזרה"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>
